datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  patient_id   Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String   @unique
  dob          DateTime
  created_at   DateTime @default(now())
}